rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Apuntes: lectura libre; solo el dueño sube en su carpeta, máx. 15 MB
    match /apuntes/{userId}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
