{
  "expo": {
    "name": "UniApuntes",
    "slug": "uniapuntes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "light",
    "primaryColor": "#123B8E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniapuntes.unp"
    },
    "android": {
      "package": "com.uniapuntes.unp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#123B8E"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/logo.jpg"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "expo-document-picker",
      "expo-notifications"
    ]
  }
}
